# ── Supabase ────────────────────────────────────────────────────────────────
# Public project credentials (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key. Required for webhook reconciliation, for trusting the order
# amount during Razorpay order creation, and for recording payments on orders.
# Online payments stay disabled until this is set. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Razorpay ────────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
# Dashboard → Webhooks → signing secret (optional but recommended)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Currency used for Razorpay orders. Use INR for Indian accounts, USD for
# international accounts (international payments must be enabled by Razorpay).
RAZORPAY_CURRENCY=USD
# If you charge in INR while the catalogue is priced in USD, set the conversion
# rate (e.g. 83). Leave empty when charging in USD.
RAZORPAY_USD_TO_INR=

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_EMAILS=owner@example.com
